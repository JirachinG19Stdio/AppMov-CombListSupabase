<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uteq_verde"
    tools:context=".ActividadSeleccion">

    <!-- ===== Cabecera azul petróleo ===== -->
    <LinearLayout
        android:id="@+id/cabecera"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo en una tarjeta blanca (el logo tiene letras oscuras) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_margin="8dp"
                android:adjustViewBounds="true"
                android:contentDescription="Logo UTEQ"
                app:srcCompat="@drawable/logouteq" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestión Académica"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Software · 6to semestre A"
                android:textColor="@color/uteq_verde_claro"
                android:textSize="13sp" />

            <!-- Barrita con los colores de las hojas del logo -->
            <View
                android:layout_width="64dp"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_barra_hojas" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Panel claro con esquinas redondeadas ===== -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_hoja"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cabecera">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.08"
            android:text="FILTRAR MATERIAS"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Paso 3: selector de semestre -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/txtListaniveles"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Semestre"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="@color/uteq_verde"
            app:startIconDrawable="@drawable/ic_semestre"
            app:startIconTint="@color/uteq_dorado">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/listaNiveles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                app:simpleItems="@array/niveles" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Paso 7: selector de materias -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/txtListaMaterias"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Materia"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="@color/uteq_verde"
            app:startIconDrawable="@drawable/ic_materia"
            app:startIconTint="@color/uteq_verde">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/listaMaterias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Paso 10: lista de alumnos (cada fila es una tarjeta) -->
        <ListView
            android:id="@+id/lvAlumnos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="16dp"
            android:scrollbars="none" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
